# ==============================================================================
# DISASTER OS — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure real credentials as needed.
# NEVER commit .env files containing real secret keys to source control.
# ==============================================================================

# Google Gemini AI Decision Support (Optional)
# If left blank, Disaster OS operates safely with GEMINI_UNAVAILABLE / LOCAL_HEURISTIC decision support
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=medium

# Weather Intelligence Provider (Optional)
# If left blank, Disaster OS automatically falls back to Open-Meteo (No API key required)
OPENWEATHER_API_KEY=

# Security & Session Authentication
SECRET_KEY=
ADMIN_TOKEN=

# Built-in demo accounts (operator@disaster.local / admin@disaster.local) seeded on startup when enabled.
# Local development and tests default to enabled when unset. Set to false for public/production deployments.
SEED_DEMO_USERS=true

# Routing & GIS Service Endpoints (Optional Overrides)
# Default public OSRM router: http://router.project-osrm.org
OSRM_BASE_URL=http://router.project-osrm.org

# Optional Custom Overpass API Mirror
# Default mirrors: kumi-systems.de, lz4.overpass-api.de, overpass.kumi.systems
OVERPASS_MIRROR_URL=

# Server Runtime Settings
PORT=8000
HOST=0.0.0.0
DEBUG=False
